# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set the same names under Project → Settings → Environment Variables.
# None of these may ever be exposed via NEXT_PUBLIC_ variables.

# The project owner enters the connection details from the Neon dashboard.
# Use the POOLED connection string (host contains "-pooler") for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Optional: DIRECT (non-pooled) connection string, used only by `npm run db:migrate`.
# If unset, migrations use DATABASE_URL. (Neon's Vercel integration sets this name automatically.)
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Secure password hashes, not plaintext passwords. Generate each with: npm run hash-password
PLAYER_PASSWORD_HASH=""
ADMIN_PASSWORD_HASH=""

# Long, randomly generated key for signing sessions (min. 32 characters).
# Generate with: npm run generate-secret
SESSION_SECRET=""

# Only for running the integration tests against a disposable local/branch database.
# Tables in this database are TRUNCATED by the tests – never point it at real data.
# TEST_DATABASE_URL="postgresql://user:pass@localhost:5432/hub_test"
